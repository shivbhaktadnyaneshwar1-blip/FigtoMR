# Gemini (ADK native) — put your key in local .env, never commit it
GEMINI_API_KEY=
ADK_MODEL=gemini-2.5-pro

# Where generated React components are written
TARGET_REPO_PATH=/path/to/your/app

# Optional preview dev server for visual compare
STUDIO_PREVIEW_URL=http://localhost:5173

# Optional JSON override for nonstandard target conventions
# TARGET_FRONTEND_PROFILE={"framework":"react","componentRoot":"ui/components","scripts":{"preview":"dev"}}

# Figma MCP (local desktop or remote)
FIGMA_MCP_URL=http://127.0.0.1:3845/mcp
FIGMA_MCP_TRANSPORT=http

# Optional merge request
GIT_REMOTE_PROJECT=org/repo
GIT_MR_TARGET_BRANCH=main
